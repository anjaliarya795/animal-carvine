# Wallet Connect Project ID (get from https://dashboard.reown.com)
VITE_WALLET_CONNECT_PROJECT_ID=your_project_id_here

# Wallet Connect URL (your domain)
VITE_WALLET_CONNECT_URL=https://yourdomain.com

# Backend API URL
VITE_BACKEND_URL=http://localhost:3001

# Backend API Key (must match WIDGET_API_KEY in backend .env)
VITE_API_KEY=your-api-key-here

# Ankr RPC API Key (optional - for higher rate limits, get from https://ankr.com)
VITE_ANKR_API_KEY=
VITE_ANKR_KEY=

// Prisma Schema for VLTC Presale
// Database: PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Round {
  id                   Int           @id @default(autoincrement())
  name                 String        @db.VarChar(100)
  description          String?       @db.Text
  isActive             Boolean       @default(false) @map("is_active")
  totalRaisedOnchain   Decimal       @default(0) @map("total_raised_onchain") @db.Decimal(20, 8)
  totalRaisedOffchain  Decimal       @default(0) @map("total_raised_offchain") @db.Decimal(20, 8)
  createdAt            DateTime      @default(now()) @map("created_at")
  updatedAt            DateTime      @updatedAt @map("updated_at")

  stages               Stage[]
  transactions         Transaction[]
  userBalances         UserBalance[]

  @@map("rounds")
}

model Stage {
  id               Int           @id @default(autoincrement())
  roundId          Int           @map("round_id")
  name             String        @db.VarChar(100)
  tokenPrice       Decimal       @map("token_price") @db.Decimal(20, 8)
  tokensAvailable  Decimal       @map("tokens_available") @db.Decimal(20, 8)
  tokensSold       Decimal       @default(0) @map("tokens_sold") @db.Decimal(20, 8)
  startTime        DateTime      @map("start_time")
  durationSeconds  Int           @map("duration_seconds")
  status           String        @default("pending") @db.VarChar(20) // pending, active, completed, cancelled
  orderIndex       Int           @map("order_index")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  round            Round         @relation(fields: [roundId], references: [id], onDelete: Cascade)
  transactions     Transaction[]

  @@unique([roundId, orderIndex], name: "round_order_unique")
  @@index([roundId, orderIndex], name: "idx_stages_round_order")
  @@map("stages")
}

model Transaction {
  id                 Int       @id @default(autoincrement())
  roundId            Int?      @map("round_id")
  stageId            Int?      @map("stage_id")
  txHash             String?   @unique @map("tx_hash") @db.VarChar(255)
  walletAddress      String    @map("wallet_address") @db.VarChar(255)
  paymentToken       String    @map("payment_token") @db.VarChar(20)
  paymentAmount      Decimal   @map("payment_amount") @db.Decimal(20, 8)
  paymentAmountUsd   Decimal   @map("payment_amount_usd") @db.Decimal(20, 8)
  tokenAmount        Decimal   @map("token_amount") @db.Decimal(20, 8)
  bonusCode          String?   @map("bonus_code") @db.VarChar(50)
  bonusPercentage    Decimal   @default(0) @map("bonus_percentage") @db.Decimal(5, 2)
  bonusTokens        Decimal   @default(0) @map("bonus_tokens") @db.Decimal(20, 8)
  chainId            Int       @map("chain_id")
  chainName          String    @map("chain_name") @db.VarChar(50)
  status             String    @default("pending") @db.VarChar(20) // pending, completed, failed
  source             String    @default("widget") @db.VarChar(20) // widget, manual, offchain
  createdBy          String?   @map("created_by") @db.VarChar(255)
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  round              Round?    @relation(fields: [roundId], references: [id])
  stage              Stage?    @relation(fields: [stageId], references: [id])
  bonusCodeUsage     BonusCodeUsage[]

  @@index([walletAddress], name: "idx_wallet")
  @@index([roundId], name: "idx_round")
  @@index([stageId], name: "idx_stage")
  @@index([status], name: "idx_status")
  @@index([walletAddress, status], name: "idx_transactions_wallet_status")
  @@index([roundId, stageId], name: "idx_transactions_round_stage")
  @@map("transactions")
}

model BonusCode {
  id                Int       @id @default(autoincrement())
  code              String    @unique @db.VarChar(50)
  percentage        Decimal   @db.Decimal(5, 2)
  maxUses           Int?      @map("max_uses")
  currentUses       Int       @default(0) @map("current_uses")
  validFrom         DateTime? @map("valid_from")
  validUntil        DateTime? @map("valid_until")
  isActive          Boolean   @default(true) @map("is_active")
  applicableRounds  String?   @map("applicable_rounds") @db.Text // JSON array
  createdBy         String    @map("created_by") @db.VarChar(255)
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  usage             BonusCodeUsage[]

  @@index([code], name: "idx_code")
  @@index([isActive], name: "idx_active")
  @@map("bonus_codes")
}

model BonusCodeUsage {
  id            Int       @id @default(autoincrement())
  bonusCodeId   Int       @map("bonus_code_id")
  transactionId Int       @map("transaction_id")
  walletAddress String    @map("wallet_address") @db.VarChar(255)
  bonusTokens   Decimal   @map("bonus_tokens") @db.Decimal(20, 8)
  usedAt        DateTime  @default(now()) @map("used_at")

  bonusCode     BonusCode   @relation(fields: [bonusCodeId], references: [id], onDelete: Cascade)
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([walletAddress], name: "idx_wallet")
  @@index([bonusCodeId], name: "idx_code")
  @@index([walletAddress, bonusCodeId], name: "idx_bonus_usage_wallet_code")
  @@map("bonus_code_usage")
}

model UserBalance {
  id               Int       @id @default(autoincrement())
  walletAddress    String    @map("wallet_address") @db.VarChar(255)
  roundId          Int       @map("round_id")
  totalPurchased   Decimal   @default(0) @map("total_purchased") @db.Decimal(20, 8)
  totalBonus       Decimal   @default(0) @map("total_bonus") @db.Decimal(20, 8)
  lockedAmount     Decimal   @default(0) @map("locked_amount") @db.Decimal(20, 8)
  unlockedAmount   Decimal   @default(0) @map("unlocked_amount") @db.Decimal(20, 8)
  nextUnlockDate   DateTime? @map("next_unlock_date")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  round            Round     @relation(fields: [roundId], references: [id])

  @@unique([walletAddress, roundId], name: "wallet_round_unique")
  @@index([walletAddress], name: "idx_wallet")
  @@map("user_balances")
}

model Admin {
  id              Int       @id @default(autoincrement())
  walletAddress   String    @unique @map("wallet_address") @db.VarChar(255)
  role            String    @db.VarChar(20) // owner, admin
  permissions     String?   @db.Text // JSON array
  isActive        Boolean   @default(true) @map("is_active")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@index([walletAddress], name: "idx_wallet")
  @@index([role], name: "idx_role")
  @@map("admins")
}

model Setting {
  id                  Int       @id @default(autoincrement())
  key                 String    @unique @db.VarChar(100)
  value               String    @db.Text
  description         String?   @db.Text
  isEditableByAdmin   Boolean   @default(false) @map("is_editable_by_admin")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  @@map("settings")
}

model AuditLog {
  id            Int       @id @default(autoincrement())
  adminWallet   String    @map("admin_wallet") @db.VarChar(255)
  action        String    @db.VarChar(100)
  tableName     String?   @map("table_name") @db.VarChar(50)
  recordId      Int?      @map("record_id")
  oldValue      String?   @map("old_value") @db.Text
  newValue      String?   @map("new_value") @db.Text
  ipAddress     String?   @map("ip_address") @db.VarChar(50)
  createdAt     DateTime  @default(now()) @map("created_at")

  @@index([adminWallet], name: "idx_admin")
  @@index([action], name: "idx_action")
  @@index([createdAt], name: "idx_created")
  @@map("audit_logs")
}